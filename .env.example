# Environment Configuration for StockSense

# Security
JWT_SECRET=stocksense_jwt_secret_dev_2026
OTP_HMAC_SECRET=stocksense_otp_hmac_super_secret_2026

# SMTP Email Configuration (for password reset OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="StockSense Support" <your-email@gmail.com>

# Test mode (delivers OTP to in-memory test mailbox when true)
EMAIL_TEST_MODE=false
