# Environment Configuration for StockSense

# Security
JWT_SECRET=stocksense_jwt_secret_dev_2026
OTP_HMAC_SECRET=stocksense_otp_hmac_super_secret_2026

# Email Configuration (for password reset OTP delivery)
# These must match the variable names read by src/lib/email.ts
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="StockSense Support <your-email@gmail.com>"

# Test mode (delivers OTP to in-memory test mailbox when true, no real SMTP needed)
EMAIL_TEST_MODE=false
